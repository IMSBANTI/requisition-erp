# Neon PostgreSQL — use the POOLED string for DATABASE_URL and the DIRECT string for DIRECT_URL
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/requisition?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/requisition?sslmode=require"

# Long random string (e.g. 64 chars). Used to sign login sessions.
SESSION_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used in QR verification codes)
APP_URL="http://localhost:3000"

# Default password given to seeded users (they should change it on first login)
SEED_DEFAULT_PASSWORD="Ims@12345"
